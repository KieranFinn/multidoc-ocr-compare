# 运行产物(体积大, 且含你自己的文档内容)
out/
uploads/
inbox/
examples/demo/
# 离线 demo 的合成 PDF 由 make_demo.py 现场生成, CI 每次重建
_attic/examples/demo/samples/
out_llm_trial/
# 归档(已确认文献的原件+产物+索引), 与 out/ 同性质: 含文档内容, 不入库
archive/
*.log

# 本地私有配置: token 等隐私值放这里, 不入库
channels.local.json

# 运行期状态
__pycache__/
*.pyc
_state_mineru.json
_server.lock
gui_runs.jsonl
.gui_prefs.json
# 工作台备注(doc -> 人工说明): 本机状态, 与 gui_runs.jsonl 同性质
gui_notes.json
# 实验区(workspaces/<name>/): 各自带 uploads/out/备注, 与正式区同性质, 不入库
workspaces/
# 跨进程名额(crossproc): 并发跑时占位用, 进程崩了会留残留, 不该入库
.locks/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.bak
*.bak[0-9]
*.bak-*
*.bak[0-9][0-9]
*~
*.swp
reviewed_docs.json
推送GitHub.bat

# 实体视图正文字数增量缓存
out/.view_body_chars.json

# 回归闸门工作产物(meta_diff.py/failures.py): 快照与 diff 是本地基线, 随时重建, 不入库
_meta_snapshot_*.zip
_meta_diff_*.json
_failures.json
_failures_*.json
_meta_backup_*.zip

# 轮次台账与进度报告(failures.py --round 产物, 本地过程数据, 每轮刷新)
_rounds.jsonl
_rounds_report.html
_kgs_toc.json

# 一次性运维脚本: 跑完即弃, 依赖本地私有数据(_doi_registry.json / raw 站点缓存), 不入库
_webfill_batch.py
_note_fmt.py
# 一次性核对产物(幂等性快照/文档号清单), 本地过程数据
_idem_*.json
_kjcss.txt

# 本地私有数据: 期刊 DOI 注册表
_doi_registry.json
